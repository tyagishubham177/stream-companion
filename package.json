{
  "name": "stream-companion",
  "version": "0.2.0",
  "private": true,
  "description": "A modular companion for streaming. V1 adds IMDb ratings to Netflix.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "fflate": "0.8.3",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  }
}
